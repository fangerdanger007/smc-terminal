# --- Сканер ---
SCANNER_ENABLED=true
SCAN_INTERVAL_SECONDS=300
CANDLES_LIMIT=500
MAX_CONCURRENCY=6
SIGNAL_MAX_AGE_HOURS=24

# --- Источники данных ---
# Если Binance недоступен из вашего региона: https://data-api.binance.vision
BINANCE_BASE_URL=https://api.binance.com
BYBIT_BASE_URL=https://api.bybit.com
# Акции США через Alpaca (без ключей используется Yahoo Finance)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_FEED=iex

# --- API ---
# Список origin через запятую; в продакшене укажите домен фронтенда
CORS_ORIGINS=*
